{
  "name": "mcp-azure-devops",
  "version": "3.0.0",
  "description": "MCP server that analyzes Azure DevOps pipeline failures with a tiered, cost-effective classifier (rule engine → cache → Claude Haiku).",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=18.18"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "mcp:stdio": "node src/mcp/stdio.js",
    "mcp:inspect": "npx @modelcontextprotocol/inspector node src/mcp/stdio.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.68.0",
    "@modelcontextprotocol/sdk": "^1.20.0",
    "axios": "^1.7.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.0",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.0",
    "joi": "^17.13.0",
    "jose": "^5.9.0",
    "prom-client": "^15.1.0",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "pino-pretty": "^13.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@vitest/coverage-v8": "^2.1.0",
    "eslint": "^9.14.0",
    "globals": "^15.12.0",
    "nock": "^13.5.0",
    "prettier": "^3.3.0",
    "supertest": "^7.0.0",
    "vitest": "^2.1.0"
  }
}
