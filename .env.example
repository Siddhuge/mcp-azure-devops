# ─── Azure DevOps ───────────────────────────────────────────────────────────
# Organization name from your dev.azure.com URL.
AZURE_ORG=your-organization
# OPTIONAL default project. Requests can target ANY project in the org by passing
# `project` explicitly (?project= on REST, or the project arg on MCP tools); this
# is just the fallback when none is given. Leave empty to require it per-request.
AZURE_PROJECT=your-project
# Personal Access Token with scopes: Build (read), and Project and Team (read)
# for org-wide project listing. Treat as a secret — never commit.
# Tip: source from a file instead with AZURE_PAT_FILE=/run/secrets/azure_pat
AZURE_PAT=your-personal-access-token
# Max concurrent Azure log fetches per build (bounds fan-out on large builds).
AZURE_MAX_CONCURRENCY=6

# ─── HTTP server ────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
LOG_LEVEL=info

# Named service tokens: "name:secret,name2:secret2" (bare "secret" -> name "default").
# Hashed at rest; used for machine-to-machine. Empty + no OIDC = auth disabled (dev only).
# Tip: source from a file instead with API_TOKENS_FILE=/run/secrets/api_tokens
API_TOKENS=

# Number of trusted reverse-proxy hops in front of the app (Express trust proxy).
# Set to 1+ when behind an ingress/load balancer so client IPs & rate-limiting work.
TRUST_PROXY=0

# ─── OIDC/JWT auth (optional, any IdP: Entra ID / Okta / Auth0) ──────────────
# When OIDC_ISSUER is set, Bearer JWTs are validated against the issuer's JWKS.
# Service tokens above still work alongside this (for machine clients).
OIDC_ISSUER=
OIDC_JWKS_URL=          # optional; defaults to <issuer>/.well-known/jwks.json
OIDC_AUDIENCE=
OIDC_REQUIRED_SCOPE=    # optional; e.g. pipelines.read (403 if missing)
# Browser PKCE login for the web UI (optional). Set OIDC_CLIENT_ID (a public SPA
# client id) to make /ui show "Sign in" instead of a pasted token. Needs an IdP
# SPA app registration with redirect URI <app-origin>/ui/.
OIDC_CLIENT_ID=
OIDC_SCOPES=openid profile   # add offline_access for refresh + your API scope, e.g. api://<api-id>/access_as_user

# Optional bearer to protect GET /metrics (empty = open, like /healthz; restrict at network).
METRICS_TOKEN=

# ─── LLM tier (optional, cost-controlled) ───────────────────────────────────
# Powers BOTH the analyzer's LLM fallback AND the /ui web chat agent. When
# disabled or no API key is set, the analyzer uses the rule engine only and the
# chat UI is unavailable (REST/MCP still work). Chat reuses LLM_MODEL + the budget.
LLM_ENABLED=false
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-4-5
# Max filtered log lines sent to the model (controls token spend).
LLM_MAX_INPUT_LINES=120
# Soft monthly spend ceiling in USD. When exceeded, the LLM tier is skipped.
LLM_MONTHLY_BUDGET_USD=25
# Redact secrets/PII (GUIDs, IPs, tokens, emails) from log content before sending
# it to the LLM (a third party). Strongly recommended; disable only if your data
# policy allows raw egress.
LLM_REDACT_INPUT=true

# ─── Result cache ───────────────────────────────────────────────────────────
CACHE_MAX_ENTRIES=500
CACHE_TTL_SECONDS=3600

# ─── Shared state (multi-replica) ───────────────────────────────────────────
# Optional. Set to a Redis URL to SHARE the result cache and the LLM monthly
# budget across replicas (so the cost cap is global and survives restarts).
# Leave empty for a single instance (in-process store). docker-compose sets this
# automatically to the bundled redis service.
REDIS_URL=
